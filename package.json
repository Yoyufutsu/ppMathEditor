{
  "name": "ppmath-editor",
  "version": "1.0.0",
  "description": "PowerPoint 用 LaTeX 数式エディタ アドイン",
  "scripts": {
    "dev-server": "node server.js",
    "preview": "node server.js --http",
    "certs": "office-addin-dev-certs install",
    "start": "office-addin-debugging start manifest.dev.xml desktop --app powerpoint",
    "stop": "office-addin-debugging stop manifest.dev.xml",
    "register": "office-addin-dev-settings register manifest.xml",
    "unregister": "office-addin-dev-settings unregister manifest.xml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-dev-settings": "^4.0.1"
  },
  "config": {
    "dev_server_port": 3000
  }
}
